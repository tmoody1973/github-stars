{
  "name": "github-stars",
  "version": "0.1.0",
  "private": true,
  "description": "A Buzz-hosted web app for searching and filtering Tarik Moody's GitHub stars.",
  "type": "module",
  "scripts": {
    "dev": "python3 -m http.server 4173",
    "check": "git ls-files '*.js' '*.mjs' | xargs -n1 node --check",
    "db:migrate": "node scripts/migrate.mjs",
    "db:ingest": "node scripts/ingest-stars.mjs"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0"
  }
}
