{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "crons": [
    {
      "path": "/api/refresh",
      "schedule": "0 11 * * *"
    },
    {
      "path": "/api/generate-post",
      "schedule": "0 12 * * 1-5"
    }
  ],
  "functions": {
    "api/generate-post.js": {
      "maxDuration": 300
    }
  }
}
